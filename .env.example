# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# GoatCounter (visit counter)
# Site code from https://www.goatcounter.com — public by design (it appears in
# the tracking script URL every visitor loads). The GoatCounter dashboard also
# needs the visitor-counter setting enabled for the count endpoint to work.
VITE_GOATCOUNTER_SITE=your_site_code
